{
  "name": "@kicad-web/renderer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "PixiJS v8 board/schematic renderer for kicad-web (CanvasHost contract)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./board": "./src/board/index.ts",
    "./themes/*": "./themes/*"
  },
  "files": ["src", "themes"],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -b",
    "gen:themes": "bun run scripts/gen-themes.ts",
    "demo:build": "bun build demo/main.ts --outdir demo/dist --target browser --format esm",
    "demo": "bun run demo/serve.ts"
  },
  "dependencies": {
    "flatbush": "4.6.2",
    "pixi.js": "8.20.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "happy-dom": "20.14.0",
    "typescript": "^5.6.0"
  }
}
