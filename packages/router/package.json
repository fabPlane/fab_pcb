{
  "name": "@fp-pcb/router",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Autorouting for FabPlane PCB: RouteInput from a Board, fabPlane/fab_router and Freerouting (Specctra DSN/SES), with results applied in one commit",
  "exports": {
    ".": "./src/index.ts",
    "./apply": "./src/apply.ts",
    "./bridge-job": "./src/bridge-job.ts",
    "./extract": "./src/extract.ts",
    "./freerouting": "./src/freerouting.ts",
    "./fab-router": "./src/fab-router.ts",
    "./js-autorouter": "./src/js-autorouter.ts",
    "./js-router": "./src/js-router.ts",
    "./specctra": "./src/specctra/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:corpus": "bun test test/corpus.test.ts",
    "test:corpus:nightly": "ROUTER_CORPUS_TIER=nightly bun test test/corpus.test.ts",
    "corpus": "bun run corpus/run.ts",
    "bench": "bun run bench/run.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@fp-pcb/client": "workspace:*",
    "@fp-pcb/proto": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
