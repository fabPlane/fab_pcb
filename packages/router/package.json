    "./specctra": "./src/specctra/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "bun test",
    "bench": "bun run bench/run.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@fp-pcb/client": "workspace:*",
    "@fp-pcb/proto": "workspace:*",
    "@tscircuit/capacity-autorouter": "0.0.885"
