{
  "name": "@fp-pcb/router",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Autorouting for FabPlane PCB: RouteInput from a Board, a JS router (tscircuit capacity-autorouter) and a Freerouting (Specctra DSN/SES) adapter, results applied with one CreateItems commit",
  "exports": {
    ".": "./src/index.ts",
    "./apply": "./src/apply.ts",
    "./bridge-job": "./src/bridge-job.ts",
    "./extract": "./src/extract.ts",
