# https://editorconfig.org — matches .prettierrc
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.{cpp,h,cmake,txt}]
# KiCad fork sources follow the fork's own _clang-format / uncrustify.cfg, not this file
indent_size = 4
