{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-tsc",
    "tsBuildInfoFile": "dist-tsc/tsconfig.tsbuildinfo",
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "types": [
      "bun",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "test",
    "vite.config.ts"
  ],
  "references": [
    {
      "path": "../../packages/proto"
    },
    {
      "path": "../../packages/client"
    },
    {
      "path": "../../packages/renderer"
    },
    {
      "path": "../../packages/router"
    }
  ]
}
